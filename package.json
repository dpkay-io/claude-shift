{
  "name": "claude-shift",
  "version": "1.1.1",
  "description": "Optimize your Claude Max 5-hour slots by scheduling strategic session pings",
  "type": "module",
  "bin": {
    "claude-shift": "./dist/index.js"
  },
  "files": [
    "dist/",
    "scripts/"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "test": "vitest run --exclude tests/cli.test.ts --exclude tests/runner.test.ts --exclude=tests/live/**",
    "test:watch": "vitest --exclude tests/cli.test.ts --exclude tests/runner.test.ts --exclude=tests/live/**",
    "test:e2e": "npm run build && vitest run tests/cli.test.ts tests/runner.test.ts",
    "test:all": "npm run build && vitest run --exclude=tests/live/**",
    "prepublishOnly": "npm run build",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "test:live": "npm run build && vitest run tests/live"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-max",
    "scheduler",
    "productivity",
    "slot-management"
  ],
  "author": "dpkay <hello@dpkay.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpkay-io/claude-shift.git"
  },
  "bugs": {
    "url": "https://github.com/dpkay-io/claude-shift/issues"
  },
  "homepage": "https://github.com/dpkay-io/claude-shift#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
